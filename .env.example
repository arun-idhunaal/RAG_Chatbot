# Secrets — copy to .env and fill in locally. Never commit .env.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
USE_LLM_CLASSIFIER=true

# Paths (optional overrides)
CHROMA_PERSIST_DIR=data/chroma
RAW_HTML_DIR=data/raw
AUDIT_LOG_DIR=data/audit
METRICS_LOG_DIR=data/metrics
EVAL_REPORT_DIR=data/eval
EMBEDDING_MODEL=BAAI/bge-m3

# Embedding: local (sentence-transformers + RAM) or huggingface (Render Free)
EMBEDDING_BACKEND=local
HF_TOKEN=

# HTTP / scrape
HTTP_TIMEOUT_SECONDS=30
ALLOW_PLAYWRIGHT=true
PLAYWRIGHT_WAIT_MS=4000

# Phase 7 API (Vite dev origin). Production serves SPA from the same host — CORS unused.
CORS_ORIGINS=http://localhost:5173

# Render: token for POST /v1/admin/ingest. Leave empty locally (endpoint 404s).
INGEST_TOKEN=
AUTO_INGEST_ON_EMPTY=false


